# Python / test caches
__pycache__/
*.pyc
.pytest_cache/
.python-version
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.bak
*~

# Secrets — never commit a real .env anywhere in the tree (defensive: a real .env added at repo
# root or in a product subdir must not be committed).
.env
**/.env
**/.env.*

# Live Claude state (never commit)
.claude.json
claude.json

# Composed/live settings written into a product root (this repo ships the TEMPLATE only)
**/.claude/settings.json

# Secrets gate (config-spec E6 / Mode B) — config-bearing skill: never commit user secrets, keep
# only templates.
secrets/*
!secrets/README.md
!secrets/.gitkeep
!*.env.template
!env.template
*credentials*.json
*.key
*.pem
!*.key.template
!*.pem.template
# Per-product PII ledgers / audit metrics: only templates + schema are tracked.
products/*/confidential-inventory.md
!products/*/confidential-inventory.md.template
metrics/**/*.jsonl

# self-evolve run artifacts (run metadata; never commit)
.sie/

# Build / iteration meta — per-round progress logs and scratch artifacts are NOT skill content
# (the skill itself ships SKILL.md/scripts/reference/docs). Keep them local, never commit.
PROGRESS.md
scratchpad/
*.log
*.tmp

# Also exclude ordinary suffix environment files in the public tool.
*.env
!*.env.template
!*.env.example
